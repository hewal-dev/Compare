      <rect pos="4,-262" width="439" height="29"><sprite depth="2" color="[darkestGrey]" type="sliced"/><label depth="4" pos="6,-2" width="155" text="{comparestattitle7}" font_size="22"/><label depth="4" pos="166,-2" width="130" text="{compareoldstat7}" font_size="22" justify="center"/><label depth="4" pos="301,-2" width="132" text="{comparenewstat7}" font_size="22" justify="center"/></rect>
    </rect>
  </append>
</configs>
